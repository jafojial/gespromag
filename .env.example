# Base de donnees PostgreSQL
DB_HOST=postgres
DB_PORT=5432
DB_NAME=gespromag
DB_USER=gespromag
DB_PASSWORD=change-me

# Port expose par l'application
APP_PORT=8080

# Cache des templates Thymeleaf (mettre a false en developpement pour un rechargement a chaud)
THYMELEAF_CACHE=true

# Compte administrateur cree automatiquement au premier demarrage si aucun utilisateur n'existe
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@gespromag.local
ADMIN_PASSWORD=change-me
